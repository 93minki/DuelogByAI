# 이 파일을 .env 로 복사한 뒤 API 키를 채워 넣으세요.  cp .env.example .env

# --- Database ---
DATABASE_URL=postgresql+asyncpg://duelog:duelog@localhost:5432/duelog

# --- Auth ---
# 32자 이상 임의 문자열로 바꾸세요. 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_DAYS=7
# HTTPS 로 배포할 때 true
COOKIE_SECURE=false

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_MODERATOR=gpt-5-mini
OPENAI_MODEL_DEBATER=gpt-5
OPENAI_MODEL_SUMMARY=gpt-5-mini

# --- Exa (웹 검색) ---
EXA_API_KEY=
EXA_NUM_RESULTS=5

# --- TypeSafe JEV (주제 판정) ---
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.6

# --- 사용량 ---
DAILY_DEBATE_LIMIT=10
MAX_SEARCH_CALLS_PER_TURN=20

# --- Frontend ---
# Next.js 가 /api/* 요청을 프록시할 백엔드 주소
BACKEND_URL=http://localhost:8000
